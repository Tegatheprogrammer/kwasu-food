<%- include('../partials/header') %>

<div class="page-header">
    <h1>Manage Users</h1>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Matric</th><th>Phone</th><th>Hostel</th><th>Status</th><th>Joined</th><th>Action</th></tr>
        </thead>
        <tbody>
            <% users.forEach(u => { %>
            <tr>
                <td><%= u.id %></td>
                <td><%= u.full_name %></td>
                <td><%= u.email %></td>
                <td><span class="badge badge-info"><%= u.role %></span></td>
                <td><%= u.matric_number || '-' %></td>
                <td><%= u.phone || '-' %></td>
                <td><%= u.hostel || '-' %></td>
                <td><span class="badge <%= u.is_active ? 'badge-success' : 'badge-error' %>"><%= u.is_active ? 'Active' : 'Inactive' %></span></td>
                <td><%= new Date(u.created_at).toLocaleDateString() %></td>
                <td>
                    <form action="/admin/users/<%= u.id %>/toggle" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-small <%= u.is_active ? 'btn-error' : 'btn-success' %>">
                            <%= u.is_active ? 'Deactivate' : 'Activate' %>
                        </button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<%- include('../partials/footer') %>
