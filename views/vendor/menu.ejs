<%- include('../partials/header') %>

<div class="page-header flex-between">
    <h1>Manage Menu</h1>
    <button class="btn btn-primary" onclick="document.getElementById('addModal').style.display='block'">+ Add Item</button>
</div>

<% if (menuItems.length === 0) { %>
    <div class="empty-state">
        <h3>No menu items yet</h3>
        <p>Add your first menu item to start selling!</p>
    </div>
<% } else { %>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Available</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% menuItems.forEach(item => { %>
            <tr>
                <td>
                    <% if (item.image_url) { %>
                        <img src="<%= item.image_url %>" alt="<%= item.name %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;">
                    <% } else { %>
                        <div style="width: 50px; height: 50px; background: #eee; border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                            <span style="font-size: 10px; color: #999;">No img</span>
                        </div>
                    <% } %>
                </td>
                <td>
                    <strong><%= item.name %></strong>
                    <br><small style="color: #999;"><%= item.description || '' %></small>
                </td>
                <td><%= item.category %></td>
                <td>₦<%= item.price %></td>
                <td>
                    <% if (item.stock_status === 'in_stock') { %>
                        <span class="badge badge-success">In Stock</span>
                    <% } else if (item.stock_status === 'almost_sold') { %>
                        <span class="badge badge-warning">Almost Sold</span>
                    <% } else if (item.stock_status === 'sold_out') { %>
                        <span class="badge badge-error">Sold Out</span>
                    <% } else if (item.stock_status === 'restocked') { %>
                        <span class="badge badge-info">Restocked</span>
                    <% } %>
                </td>
                <td><span class="badge <%= item.is_available ? 'badge-success' : 'badge-error' %>"><%= item.is_available ? 'Available' : 'Unavailable' %></span></td>
                <td class="actions">
                    <!-- EDIT BUTTON: Uses data attributes, NO inline onclick -->
                    <button class="btn btn-small edit-btn"
                            data-id="<%= item.id %>"
                            data-name="<%= item.name %>"
                            data-desc="<%= item.description || '' %>"
                            data-price="<%= item.price %>"
                            data-category="<%= item.category %>"
                            data-images='<%- JSON.stringify(item.images || []) %>'
                            data-stock="<%= item.stock_status %>">Edit</button>

                    <form action="/vendor/menu/toggle/<%= item.id %>" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-small btn-outline"><%= item.is_available ? 'Disable' : 'Enable' %></button>
                    </form>
                    <form action="/vendor/menu/delete/<%= item.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this item?')">
                        <button type="submit" class="btn btn-small btn-error">Delete</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<% } %>

<!-- ADD MODAL -->
<div id="addModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close-btn" onclick="document.getElementById('addModal').style.display='none'">&times;</span>
        <h2>Add Menu Item</h2>
        <form action="/vendor/menu/add" method="POST" id="addForm">
            <div class="form-group"><label>Name *</label><input type="text" name="name" required></div>
            <div class="form-group"><label>Description</label><textarea name="description" rows="2"></textarea></div>
            <div class="form-group"><label>Price (₦) *</label><input type="number" name="price" step="0.01" required></div>
            <div class="form-group"><label>Category *</label><input type="text" name="category" required placeholder="e.g. Rice, Swallow, Snacks"></div>

            <!-- FILE UPLOADS: up to 5 photos, first one is the cover shown in listings -->
            <div class="form-group">
                <label>Food Photos (up to 5)</label>
                <div class="image-slots">
                    <% for (let i = 1; i <= 5; i++) { %>
                    <div class="image-slot">
                        <label class="image-slot-btn" for="addFoodImage<%= i %>">
                            <div class="image-slot-preview" id="addPreview<%= i %>">
                                <img alt="">
                                <span class="image-slot-plus">+</span>
                            </div>
                        </label>
                        <small><%= i === 1 ? 'Cover' : 'Photo ' + i %></small>
                        <input type="file" id="addFoodImage<%= i %>" accept="image/jpeg,image/png,image/webp" hidden>
                        <input type="hidden" name="image_url<%= i === 1 ? '' : '_' + i %>" id="addImageUrl<%= i %>">
                    </div>
                    <% } %>
                </div>
            </div>

            <div class="form-group"><label>Stock Status</label>
                <select name="stock_status">
                    <option value="in_stock" selected>In Stock</option>
                    <option value="almost_sold">Almost Sold</option>
                    <option value="sold_out">Sold Out</option>
                    <option value="restocked">Restocked</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Add Item</button>
        </form>
    </div>
</div>

<!-- EDIT MODAL -->
<div id="editModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close-btn" onclick="document.getElementById('editModal').style.display='none'">&times;</span>
        <h2>Edit Menu Item</h2>
        <form action="" method="POST" id="editForm">
            <div class="form-group"><label>Name *</label><input type="text" name="name" id="editName" required></div>
            <div class="form-group"><label>Description</label><textarea name="description" id="editDesc" rows="2"></textarea></div>
            <div class="form-group"><label>Price (₦) *</label><input type="number" name="price" id="editPrice" step="0.01" required></div>
            <div class="form-group"><label>Category *</label><input type="text" name="category" id="editCategory" required></div>

            <!-- FILE UPLOADS: up to 5 photos, first one is the cover shown in listings -->
            <div class="form-group">
                <label>Food Photos (up to 5)</label>
                <div class="image-slots">
                    <% for (let i = 1; i <= 5; i++) { %>
                    <div class="image-slot">
                        <label class="image-slot-btn" for="editFoodImage<%= i %>">
                            <div class="image-slot-preview" id="editPreview<%= i %>">
                                <img alt="">
                                <span class="image-slot-plus">+</span>
                            </div>
                        </label>
                        <small><%= i === 1 ? 'Cover' : 'Photo ' + i %></small>
                        <input type="file" id="editFoodImage<%= i %>" accept="image/jpeg,image/png,image/webp" hidden>
                        <input type="hidden" name="image_url<%= i === 1 ? '' : '_' + i %>" id="editImageUrl<%= i %>">
                    </div>
                    <% } %>
                </div>
            </div>

            <div class="form-group"><label>Stock Status</label>
                <select name="stock_status" id="editStock">
                    <option value="in_stock">In Stock</option>
                    <option value="almost_sold">Almost Sold</option>
                    <option value="sold_out">Sold Out</option>
                    <option value="restocked">Restocked</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Update Item</button>
        </form>
    </div>
</div>

<script>
// ===== IMAGE UPLOAD & PREVIEW (shared by both modals, slots 1-5) =====
function handleImageUpload(input, previewId, hiddenId) {
    var previewDiv = document.getElementById(previewId);
    var previewImg = previewDiv.querySelector('img');
    var hiddenInput = document.getElementById(hiddenId);

    if (input.files && input.files[0]) {
        var file = input.files[0];

        var reader = new FileReader();
        reader.onload = function(e) {
            previewImg.src = e.target.result;
            previewDiv.classList.add('has-image');
        };
        reader.readAsDataURL(file);

        var formData = new FormData();
        formData.append('food_image', file);

        fetch('/vendor/menu/upload-image', {
            method: 'POST',
            body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                hiddenInput.value = data.imageUrl;
                previewImg.src = data.imageUrl;
            } else {
                alert('Upload failed: ' + (data.error || 'Unknown error'));
            }
        })
        .catch(function(err) {
            console.error('Upload error:', err);
            alert('Image upload failed. Please try again.');
        });
    }
}

function setSlotImage(previewId, hiddenId, url) {
    var previewDiv = document.getElementById(previewId);
    var previewImg = previewDiv.querySelector('img');
    document.getElementById(hiddenId).value = url || '';
    if (url) {
        previewImg.src = url;
        previewDiv.classList.add('has-image');
    } else {
        previewImg.src = '';
        previewDiv.classList.remove('has-image');
    }
}

for (var i = 1; i <= 5; i++) {
    (function(slot) {
        document.getElementById('addFoodImage' + slot).addEventListener('change', function() {
            handleImageUpload(this, 'addPreview' + slot, 'addImageUrl' + slot);
        });
        document.getElementById('editFoodImage' + slot).addEventListener('change', function() {
            handleImageUpload(this, 'editPreview' + slot, 'editImageUrl' + slot);
        });
    })(i);
}

// Reset the Add modal's photo slots each time it's opened fresh
document.querySelector('button[onclick*="addModal"]').addEventListener('click', function() {
    document.getElementById('addForm').reset();
    for (var i = 1; i <= 5; i++) {
        setSlotImage('addPreview' + i, 'addImageUrl' + i, '');
    }
});

// ===== EDIT BUTTON CLICK HANDLER =====
document.querySelectorAll('.edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var id = this.getAttribute('data-id');
        var name = this.getAttribute('data-name');
        var desc = this.getAttribute('data-desc');
        var price = this.getAttribute('data-price');
        var category = this.getAttribute('data-category');
        var images = JSON.parse(this.getAttribute('data-images') || '[]');
        var stock = this.getAttribute('data-stock');

        document.getElementById('editForm').action = '/vendor/menu/edit/' + id;
        document.getElementById('editName').value = name;
        document.getElementById('editDesc').value = desc;
        document.getElementById('editPrice').value = price;
        document.getElementById('editCategory').value = category;
        document.getElementById('editStock').value = stock || 'in_stock';

        for (var i = 1; i <= 5; i++) {
            setSlotImage('editPreview' + i, 'editImageUrl' + i, images[i - 1] || '');
        }

        document.getElementById('editModal').style.display = 'block';
    });
});

// ===== CLOSE MODAL ON OUTSIDE CLICK =====
window.onclick = function(event) {
    if (event.target.classList.contains('modal')) {
        event.target.style.display = 'none';
    }
}
</script>

<%- include('../partials/footer') %>
