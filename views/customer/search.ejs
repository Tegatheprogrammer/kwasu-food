<%- include('../partials/header') %>

<div class="page-header">
    <h1> Search Foods</h1>
    <p>Find your favorite meals across all vendors</p>
</div>

<form action="/customer/search" method="GET" class="search-bar">
    <input type="text" name="q" value="<%= query || '' %>" placeholder="Search for food, snack, drink..." required>
    <button type="submit" class="btn btn-primary">Search</button>
    <% if (query) { %>
        <a href="/customer/search" class="btn btn-outline">Clear</a>
    <% } %>
</form>

<% if (query) { %>
    <% if (results.length === 0) { %>
        <div class="empty-state">
            <h3>No results for "<%= query %>"</h3>
            <p>Try searching with different keywords.</p>
        </div>
    <% } else { %>
        
        <% if (vendors.length > 0) { %>
        <h2 style="margin-bottom: 15px;">Vendors Found</h2>
        <div class="vendor-grid" style="margin-bottom: 40px;">
            <% vendors.forEach(vendor => { %>
            <div class="vendor-card">
                <div class="vendor-header">
                    <h3><%= vendor.shop_name %></h3>
                </div>
                <p class="vendor-desc">📍 <%= vendor.location %></p>
                <a href="/customer/menu/<%= vendor.id %>" class="btn btn-primary btn-block">View Menu</a>
            </div>
            <% }) %>
        </div>
        <% } %>

        <h2 style="margin-bottom: 15px;">Food Items</h2>
        <div class="menu-grid">
            <% results.forEach(item => { %>
            <div class="menu-card">
                <div class="food-image">
                    <% if (item.image_url) { %>
                        <img src="<%= item.image_url %>" alt="<%= item.name %>">
                    <% } else { %>
                        <div class="food-image-placeholder"><span>🍽</span></div>
                    <% } %>
                </div>

                <% if (item.stock_status === 'sold_out') { %>
                    <span class="badge badge-error" style="position: absolute; top: 10px; right: 10px;">SOLD OUT</span>
                <% } else if (item.stock_status === 'almost_sold') { %>
                    <span class="badge badge-warning" style="position: absolute; top: 10px; right: 10px;">ALMOST SOLD</span>
                <% } else if (item.stock_status === 'restocked') { %>
                    <span class="badge badge-info" style="position: absolute; top: 10px; right: 10px;">RESTOCKED</span>
                <% } %>

                <div class="menu-info">
                    <h4><%= item.name %></h4>
                    <p><%= item.description || '' %></p>
                    <span class="menu-price">₦<%= item.price %></span>
                </div>
                <p style="color: var(--primary-dark); font-size: 0.85rem; padding: 0 1rem; margin-bottom: 0.5rem;">
                    📍 <%= item.shop_name %>
                </p>
                <div style="padding: 0 1rem 1rem;">
                    <a href="/customer/menu/<%= item.vendor_id %>" class="btn btn-primary btn-block btn-small">View Vendor</a>
                </div>
            </div>
            <% }) %>
        </div>
    <% } %>
<% } else { %>
    <div class="empty-state">
        <h3>Search for your favorite foods</h3>
        <p>Type a food name, category, or description above.</p>
    </div>
<% } %>

<%- include('../partials/footer') %>