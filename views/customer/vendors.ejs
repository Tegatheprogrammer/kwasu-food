<%- include('../partials/header') %>

<div class="page-header">
    <h1>Browse Vendors</h1>
    <p>Discover delicious food from vendors around KWASU campus</p>
</div>

<!-- Search -->
<div style="margin-bottom: 25px; display: flex; gap: 10px;">
    <form action="/customer/vendors" method="GET" style="display: flex; gap: 10px; flex: 1;">
        <input type="text" name="search" value="<%= search || '' %>" placeholder="Search vendors by name or location..." 
               style="flex: 1; padding: 10px 15px; border: 1px solid #ddd; border-radius: 8px;">
        <button type="submit" class="btn btn-primary">Search</button>
        <% if (search) { %>
            <a href="/customer/vendors" class="btn btn-outline">Clear</a>
        <% } %>
    </form>
    <a href="/customer/search" class="btn btn-accent">Search Foods</a>
</div>

<div class="vendor-grid">
    <% if (vendors.length === 0) { %>
        <div class="empty-state full-width">
            <h3><%= search ? 'No vendors match "' + search + '"' : 'No vendors available right now' %></h3>
            <p><%= search ? 'Try a different search term.' : 'Check back later!' %></p>
        </div>
    <% } else { %>
        <% vendors.forEach(vendor => { %>
        <div class="vendor-card">
            <div class="vendor-header">
                <h3><%= vendor.shop_name %></h3>
                <span class="badge badge-success">Open</span>
            </div>
            <p class="vendor-desc"><%= vendor.description || 'Delicious meals available!' %></p>
            <div class="vendor-meta">
                <span>📍 <%= vendor.location %></span>
                <span>📞 <%= vendor.phone || 'N/A' %></span>
                <% if (vendor.menu_count) { %><span>🍽 <%= vendor.menu_count %> items</span><% } %>
            </div>
            <a href="/customer/menu/<%= vendor.id %>" class="btn btn-primary btn-block">View Menu</a>
        </div>
        <% }) %>
    <% } %>
</div>

<%- include('../partials/footer') %>