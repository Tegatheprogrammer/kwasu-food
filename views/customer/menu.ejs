<%- include('../partials/header') %>

<% const isCustomerUser = user && user.role === 'customer'; %>
<% const categories = Object.keys(groupedMenu); %>
<% const allItems = categories.flatMap(cat => groupedMenu[cat].map(item => ({ ...item, category: cat }))); %>

<div class="page-header">
    <h1><%= vendor.shop_name %></h1>
    <p><%= vendor.description || '' %> | 📍 <%= vendor.location %></p>
</div>

<!-- Compact cart bar, sticky right under the navbar on mobile so checkout never needs a long scroll -->
<% if (isCustomerUser) { %>
<div id="mobileCartBar" class="mobile-cart-bar">
    <span id="mobileCartSummary">Cart is empty</span>
    <button type="button" class="btn btn-primary btn-small" onclick="openOrderModal()">View Cart</button>
</div>
<% } %>

<% if (categories.length > 1) { %>
<div class="category-tabs" id="categoryTabs">
    <button type="button" class="category-tab active" data-category="all">All</button>
    <% categories.forEach(cat => { %>
        <button type="button" class="category-tab" data-category="<%= cat %>"><%= cat %></button>
    <% }) %>
</div>
<% } %>

<div class="menu-layout">
    <div class="menu-items">
        <% if (allItems.length === 0) { %>
            <div class="empty-state"><h3>No menu items available</h3></div>
        <% } else { %>
            <div class="food-grid" id="foodGrid">
                <% allItems.forEach(item => { %>
                <% const images = item.images && item.images.length ? item.images : null; %>
                <div class="food-card <%= item.stock_status === 'sold_out' ? 'sold-out' : '' %>" data-category="<%= item.category %>">
                    <div class="food-card-media">
                        <% if (images) { %>
                            <button type="button" class="food-card-image gallery-trigger" data-images='<%- JSON.stringify(images) %>' data-title="<%= item.name %>" aria-label="View photos of <%= item.name %>">
                                <img src="<%= images[0] %>" alt="<%= item.name %>">
                                <% if (images.length > 1) { %><span class="gallery-count">+<%= images.length - 1 %></span><% } %>
                            </button>
                        <% } else { %>
                            <div class="food-card-image">
                                <div class="food-image-placeholder"><span>🍽</span></div>
                            </div>
                        <% } %>

                        <% if (item.stock_status === 'sold_out') { %>
                            <span class="badge badge-error" style="position: absolute; top: 8px; left: 8px;">SOLD OUT</span>
                        <% } else if (item.stock_status === 'almost_sold') { %>
                            <span class="badge badge-warning" style="position: absolute; top: 8px; left: 8px;">ALMOST SOLD</span>
                        <% } else if (item.stock_status === 'restocked') { %>
                            <span class="badge badge-info" style="position: absolute; top: 8px; left: 8px;">RESTOCKED</span>
                        <% } %>

                        <% if (item.stock_status !== 'sold_out') { %>
                            <button type="button" class="add-cart-fab add-cart-btn"
                                data-id="<%= item.id %>"
                                data-name="<%= item.name %>"
                                data-price="<%= item.price %>"
                                aria-label="Add <%= item.name %> to cart">+</button>
                        <% } %>
                    </div>
                    <div class="food-card-body">
                        <h4><%= item.name %></h4>
                        <% if (item.description) { %><p><%= item.description %></p><% } %>
                        <div class="food-card-footer">
                            <span class="menu-price">₦<%= item.price %></span>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <% if (isCustomerUser) { %>
    <div class="cart-sidebar">
        <h3>Your Cart</h3>
        <div id="cartItems" class="cart-items"><p class="empty-cart">Cart is empty</p></div>
        <div class="cart-total"><strong>Total: ₦<span id="cartTotal">0</span></strong></div>

        <form action="/customer/place-order" method="POST" id="desktopOrderForm">
            <input type="hidden" name="vendor_id" value="<%= vendor.id %>">
            <input type="hidden" name="cart_items" id="cartInputDesktop">
            <div class="form-group">
                <label>Delivery Hostel *</label>
                <input type="text" name="delivery_hostel" value="<%= user.hostel || '' %>" required placeholder="e.g. A Block">
            </div>
            <div class="form-group">
                <label>Detailed Address</label>
                <textarea name="delivery_address" rows="2" placeholder="Room number, floor, etc."></textarea>
            </div>
            <div class="form-group">
                <label>Notes (optional)</label>
                <textarea name="notes" rows="2" placeholder="Any special requests?"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-block" id="checkoutBtn" disabled>Place Order</button>
        </form>
    </div>
    <% } else { %>
    <div class="guest-cta-card">
        <div class="cta-icon">🛒</div>
        <h3>Ready to order?</h3>
        <p>Create a free account to add items to your cart and check out.</p>
        <a href="/register" class="btn btn-primary btn-block">Sign Up</a>
        <a href="/login" class="btn btn-outline btn-block" style="margin-top: 0.5rem;">Log In</a>
    </div>
    <% } %>
</div>

<!-- Mobile checkout: same cart + delivery details, presented as an overlay so it never requires scrolling past the menu -->
<% if (isCustomerUser) { %>
<div id="orderModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close-btn" onclick="closeOrderModal()">&times;</span>
        <h2>Complete Order</h2>
        <form action="/customer/place-order" method="POST" id="orderForm">
            <input type="hidden" name="vendor_id" value="<%= vendor.id %>">
            <input type="hidden" name="cart_items" id="cartInput">
            <div class="form-group">
                <label>Delivery Hostel *</label>
                <input type="text" name="delivery_hostel" value="<%= user.hostel || '' %>" required placeholder="e.g. A Block">
            </div>
            <div class="form-group">
                <label>Detailed Address</label>
                <textarea name="delivery_address" rows="2" placeholder="Room number, floor, etc."></textarea>
            </div>
            <div class="form-group">
                <label>Notes (optional)</label>
                <textarea name="notes" rows="2" placeholder="Any special requests?"></textarea>
            </div>
            <div class="order-summary">
                <h4>Order Summary</h4>
                <div id="orderSummary"></div>
                <p class="summary-total">Total: ₦<span id="summaryTotal">0</span></p>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Confirm Order</button>
        </form>
    </div>
</div>
<% } %>

<!-- Photo gallery lightbox for items with more than one uploaded photo -->
<div id="galleryModal" class="modal" style="display:none;">
    <div class="modal-content gallery-modal-content">
        <span class="close-btn" onclick="closeGallery()">&times;</span>
        <h2 id="galleryTitle"></h2>
        <div class="gallery-viewer">
            <button type="button" class="gallery-nav gallery-prev" onclick="galleryStep(-1)" aria-label="Previous photo">&lsaquo;</button>
            <img id="galleryImage" alt="">
            <button type="button" class="gallery-nav gallery-next" onclick="galleryStep(1)" aria-label="Next photo">&rsaquo;</button>
        </div>
        <p class="gallery-counter"><span id="galleryPos">1</span> / <span id="galleryTotal">1</span></p>
    </div>
</div>

<script>
    // Cart state (add/remove/render) lives in main.js and persists via localStorage.
    // This page only needs to wire up its own "add to cart" buttons.
    const IS_LOGGED_IN_CUSTOMER = <%= isCustomerUser ? 'true' : 'false' %>;

    document.querySelectorAll('.add-cart-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (!IS_LOGGED_IN_CUSTOMER) {
                window.location.href = '/register';
                return;
            }
            addToCart(
                parseInt(this.dataset.id),
                this.dataset.name,
                parseFloat(this.dataset.price),
                this
            );
        });
    });

    // ===== Category filter tabs =====
    document.querySelectorAll('.category-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.category-tab').forEach(t => t.classList.remove('active'));
            this.classList.add('active');
            const category = this.dataset.category;
            document.querySelectorAll('.food-card').forEach(card => {
                const matches = category === 'all' || card.dataset.category === category;
                card.classList.toggle('hidden-by-filter', !matches);
            });
        });
    });

    // ===== Photo gallery lightbox =====
    let galleryImages = [];
    let galleryIndex = 0;

    function renderGallerySlide() {
        document.getElementById('galleryImage').src = galleryImages[galleryIndex];
        document.getElementById('galleryPos').textContent = galleryIndex + 1;
        document.getElementById('galleryTotal').textContent = galleryImages.length;
    }

    function galleryStep(delta) {
        galleryIndex = (galleryIndex + delta + galleryImages.length) % galleryImages.length;
        renderGallerySlide();
    }

    function closeGallery() {
        document.getElementById('galleryModal').style.display = 'none';
    }

    document.querySelectorAll('.gallery-trigger').forEach(btn => {
        btn.addEventListener('click', function() {
            galleryImages = JSON.parse(this.dataset.images || '[]');
            if (galleryImages.length === 0) return;
            galleryIndex = 0;
            document.getElementById('galleryTitle').textContent = this.dataset.title || '';
            const modal = document.getElementById('galleryModal');
            const multi = galleryImages.length > 1;
            modal.querySelector('.gallery-prev').style.display = multi ? 'flex' : 'none';
            modal.querySelector('.gallery-next').style.display = multi ? 'flex' : 'none';
            renderGallerySlide();
            modal.style.display = 'flex';
        });
    });
</script>

<%- include('../partials/footer') %>
