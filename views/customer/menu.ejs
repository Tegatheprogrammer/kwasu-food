<%- include('../partials/header') %>

<div class="page-header">
    <h1><%= vendor.shop_name %></h1>
    <p><%= vendor.description || '' %> | 📍 <%= vendor.location %></p>
</div>

<div class="menu-layout">
    <div class="menu-items">
        <% if (Object.keys(groupedMenu).length === 0) { %>
            <div class="empty-state"><h3>No menu items available</h3></div>
        <% } else { %>
            <% for (const [category, items] of Object.entries(groupedMenu)) { %>
            <div class="menu-category">
                <h2 class="category-title"><%= category %></h2>
                <div class="menu-grid">
                    <% items.forEach(item => { %>
                    <div class="menu-card" data-id="<%= item.id %>" data-name="<%= item.name %>" data-price="<%= item.price %>">
                        <div class="menu-info">
                            <h4><%= item.name %></h4>
                            <p><%= item.description || '' %></p>
                            <span class="menu-price">₦<%= item.price %></span>
                        </div>
                        <button class="btn btn-accent btn-small" onclick="addToCart(<%= item.id %>, '<%= item.name %>', <%= item.price %>)">Add to Cart</button>
                    </div>
                    <% }) %>
                </div>
            </div>
            <% } %>
        <% } %>
    </div>
    <div class="cart-sidebar">
        <h3>Your Cart</h3>
        <div id="cartItems" class="cart-items"><p class="empty-cart">Cart is empty</p></div>
        <div class="cart-total"><strong>Total: ₦<span id="cartTotal">0</span></strong></div>
        <button class="btn btn-primary btn-block" onclick="openOrderModal()" id="checkoutBtn" disabled>Place Order</button>
    </div>
</div>

<div id="orderModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close-btn" onclick="closeOrderModal()">&times;</span>
        <h2>Complete Order</h2>
        <form action="/customer/place-order" method="POST" id="orderForm">
            <input type="hidden" name="vendor_id" value="<%= vendor.id %>">
            <input type="hidden" name="cart_items" id="cartInput">
            <div class="form-group">
                <label>Delivery Hostel *</label>
                <input type="text" name="delivery_hostel" value="<%= user.hostel || '' %>" required placeholder="e.g. A Block">
            </div>
            <div class="form-group">
                <label>Detailed Address</label>
                <textarea name="delivery_address" rows="2" placeholder="Room number, floor, etc."></textarea>
            </div>
            <div class="form-group">
                <label>Notes (optional)</label>
                <textarea name="notes" rows="2" placeholder="Any special requests?"></textarea>
            </div>
            <div class="order-summary">
                <h4>Order Summary</h4>
                <div id="orderSummary"></div>
                <p class="summary-total">Total: ₦<span id="summaryTotal">0</span></p>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Confirm Order</button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
